<?xml version="1.0" encoding="utf-8"?>
<!-- OLED plate behind the home-screen widget: near-black hull, thin edge, amber rail on the left. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_hull" />
            <stroke android:width="1dp" android:color="@color/widget_edge" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start|fill_vertical" android:top="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_amber" />
        </shape>
    </item>
</layer-list>
